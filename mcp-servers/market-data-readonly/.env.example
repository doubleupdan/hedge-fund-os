# Which provider implementation to use. Defaults to 'mock' if unset.
# Once a vendor is chosen (see docs/decision-log/OPEN-QUESTIONS.md #2),
# add a providers/<name>_provider.py and set PROVIDER=<name> here.
PROVIDER=mock

# Vendor API key — add once a provider is chosen. Never commit the real
# .env file (see root .gitignore).
# MARKET_DATA_API_KEY=
