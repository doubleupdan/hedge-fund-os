# Secrets — never commit real credentials
.env
*.env
!.env.example
**/secrets/
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node (n8n / future tooling)
node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local scratch — generated reports/logs shouldn't be hand-committed;
# they belong in Postgres and get exported deliberately, not accumulated
# as loose files in the repo.
docs/reports/**/*.local.*
*.log

# APEX OS desktop app — generated artefacts.
# renderer/vendor/ is produced by `npm run vendor` (supabase-js bundle +
# JetBrains Mono woff2). It is reproducible from package.json, so it is built
# rather than committed.
apex-os/dist/
apex-os/renderer/vendor/
